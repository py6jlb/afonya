@page "/"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Shared.Contracts
@using WebUI.Services.Interfaces
@using Microsoft.Extensions.Logging

@inject IOperationsService OperationsService
@inject ICategoryService CategoryService

@inject ILogger<Operations> _logger

<PageTitle>Operations</PageTitle>

<MudGrid>
    <MudItem xs="12">
        <MudSpacer />
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" IconColor="Color.Primary">Добавить
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    IEnumerable<MoneyTransactionDto>? data;
    IEnumerable<CategoryDto>? categories;
    protected override async void OnInitialized()
    {
        data = await OperationsService.LoadOperations();
        categories = await CategoryService.LoadCategories();
        _logger.LogInformation("Loaded data", new { data, categories });
    }
}
