@model MoneyTransactionDto

<tr>
  <td>@Model.TransactionDate?.ToString("D")</td>
  <td>@Model.FromUserName</td>
  <td>@Model.Sign@Model.Value</td>
  <td>@Model.CategoryIcon@Model.CategoryHumanName</td>
  <td>
    <a class="icon-link text-decoration-none link-warning me-3" data-bs-toggle="tooltip" data-bs-placement="top"
      title="Редактировать" asp-area="" asp-page="/Transactions/Edit">
      <i class="bi bi-pencil"></i>
    </a>
    <a class="icon-link text-decoration-none link-danger me-3" data-bs-toggle="tooltip" data-bs-placement="top"
      title="Удалить" asp-area="" asp-page="/Transactions/Delete">
      <i class="bi bi-trash"></i>
    </a>
  </td>
</tr>