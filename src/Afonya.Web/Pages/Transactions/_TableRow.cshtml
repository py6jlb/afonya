@model MoneyTransactionDto

<tr>
  <td>@Model.TransactionDate?.ToString("D")</td>
  <td>@Model.FromUserName</td>
  <td>@Model.Sign@Model.Value</td>
  <td>@Model.CategoryIcon@Model.CategoryHumanName</td>
  <td>
    <a class="icon-link text-decoration-none link-warning me-3" asp-page="Edit" asp-route-id="@Model.Id"
      data-bs-toggle="tooltip" data-bs-placement="top" title="Редактировать">
      <i class="bi bi-pencil"></i>
    </a>
    <a class="icon-link text-decoration-none link-danger me-3" asp-page="Delete" asp-route-id="@Model.Id"
      data-bs-toggle="tooltip" data-bs-placement="top" title="Удалить">
      <i class="bi bi-trash"></i>
    </a>
  </td>
</tr>