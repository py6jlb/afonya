@page
@model Afonya.Web.Pages.Transactions.IndexModel
@{
    ViewData["Title"] = "Транзакции";
}

<div itemid="=content">
    <div class="container-fluid">
        <h4 class="mb-1 font-weight-bold text-primary">Транзакции</h4>
        <a asp-area="" asp-page="/Transactions/AddTransaction">Добавить запись</a>
        @if (Model?.Transactions?.Count() > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Дата</th>
                        <th scope="col">Автор</th>
                        <th scope="col">Сумма</th>
                        <th scope="col">Категория</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.Transactions)
                    {
                        <partial name="_TableRow" model="@transaction" />
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>