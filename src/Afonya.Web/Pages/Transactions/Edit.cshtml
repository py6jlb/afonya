@page "{id}"
@model Afonya.Web.Pages.Transactions.EditModel
@{
    ViewData["Title"] = "Редактирование транзакции";
}

<form method="post">
    <input type="text" name="id" hidden class="form-control" id="sum" asp-for="@Model.Transaction.Id">
    <div class="mb-3">
        <label for="sign" class="form-label">Тип операции</label>
        <select id="sign" name="sign" class="form-select" aria-describedby="signHelp" asp-for="@Model.Transaction.Sign">
            <option value="-" selected>Расход</option>
            <option value="+">Приход</option>
        </select>
        <div id="signHelp" class="form-text">Выберете Тип операции</div>
    </div>
    <div class="mb-3">
        <label for="sum" class="form-label">Сумма</label>
        <input type="number" name="value" min="1" step="0.1" class="form-control" id="sum" aria-describedby="sumHelp"
            asp-for="@Model.Transaction.Value">
        <div id="sumHelp" class="form-text">Введите сумму</div>
    </div>
    <div class="mb-3">
        <label for="date" class="form-label">Дата операции</label>
        <input type="date" name="transactionDate" class="form-control" id="date" aria-describedby="dateHelp"
            asp-for="@Model.Transaction.TransactionDate">
        <div id="dateHelp" class="form-text">Введите дату операции</div>
    </div>
    <div class="mb-3">
        <label for="category" class="form-label">Категория</label>
        <select id="category" name="categoryId" class="form-select" aria-describedby="categoryHelp"
            asp-for="@Model.Transaction.CategoryId" asp-items="Model.Categories">
        </select>
        <div id="categoryHelp" class="form-text">Выберете категорию операции</div>
    </div>
    <div class="mb-3">
        <label for="note" class="form-label">Заметка</label>
        <input type="text" id="note" name="note" class="form-select" aria-describedby="noteHelp"
            asp-for="@Model.Transaction.Note">
        <div id="noteHelp" class="form-text">Можно добавить заметку</div>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-secondary" asp-area="" asp-page="/Transactions/Index">Отмена</a>
    </div>
</form>