@model UserDto

<tr>
  <td>@Model.Login</td>
  <td>@(Model.IsAdmin ? "Да" : "Нет")
  </td>
  <td>
    <a class="btn btn-outline-warning btn-sm text-decoration-none me-1" asp-page="Edit" asp-route-id="@Model.Id"
      data-bs-toggle="tooltip" data-bs-placement="top" title="Редактировать">
      <i class="bi bi-pencil"></i>
    </a>
    <a class="btn btn-outline-info btn-sm text-decoration-none me-1" asp-page="ChangePassword"
      asp-route-id="@Model.Id" data-bs-toggle="tooltip" data-bs-placement="top" title="Сменить пароль">
      <i class="bi bi-key"></i>
    </a>
    <a class="btn btn-outline-danger btn-sm text-decoration-none me-1" asp-page="Delete" asp-route-id="@Model.Id"
      data-bs-toggle="tooltip" data-bs-placement="top" title="Удалить">
      <i class="bi bi-trash"></i>
    </a>
  </td>
</tr>