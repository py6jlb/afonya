@model UserDto

<tr>
  <td>@Model.Login</td>
  <td>@(Model.IsAdmin ? "Да" : "Нет")
  </td>
  <td>
    <a class="btn btn-outline-danger btn-sm text-decoration-none me-3" asp-page="Delete" asp-route-id="@Model.Id"
      data-bs-toggle="tooltip" data-bs-placement="top" title="Удалить">
      <i class="bi bi-trash"></i>
    </a>
  </td>
</tr>