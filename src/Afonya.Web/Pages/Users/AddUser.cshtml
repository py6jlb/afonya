@page
@model Afonya.Web.Pages.Users.AddUserModel
@{
    ViewData["Title"] = "Новый пользователь";
}

<form method="post">
    <div class="mb-3">
        <label for="login" class="form-label">Логин</label>
        <input type="text" name="login" class="form-control" id="login" aria-describedby="loginHelp">
        <div id="loginHelp" class="form-text">Введите логин. Для сопоставления транзакций записанных через бота, логин
            должен быть такой же как ник в телеграмм.</div>
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Пароль</label>
        <input type="password" name="password" class="form-control" id="password" aria-describedby="passwordHelp">
        <div id="passwordHelp" class="form-text">Придумайте пароль</div>
    </div>

    <div class="mb-3">
        <input type="checkbox" name="isAdmin" class="form-check-input" id="isAdmin" asp-for="@Model.IsAdmin">
        <label for="isAdmin" class="form-label">Пользователь является администратором</label>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-secondary" asp-area="" asp-page="/Users/Index">Отмена</a>
    </div>

</form>