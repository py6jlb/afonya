@page
@model Afonya.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div itemid="=content">
    <div class="container-fluid">
        <h4 class="mb-1 font-weight-bold text-primary">Пользователи</h4>
        <a asp-area="" asp-page="/Users/AddUser">Добавить запись</a>
        @if (Model?.Users?.Count() > 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Имя</th>
                        <th scope="col">Администратор</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.Users)
                    {
                        <partial name="_TableRow" model="@transaction" />
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>
