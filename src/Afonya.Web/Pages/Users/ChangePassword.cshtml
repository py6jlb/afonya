@page "{id}"
@model Afonya.Web.Pages.Users.ChangePasswordModel
@{
    ViewData["Title"] = "Сменить пароль";
}

<form method="post">
    <div class="mb-3">
        <label for="newPassword" class="form-label">Пароль</label>
        <input type="password" name="newPassword" asp-for="@Model.NewPassword" class="form-control" id="password"
            aria-describedby="newPasswordHelp">
        <div id="newPasswordHelp" class="form-text">Придумайте новый пароль</div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-secondary" asp-area="" asp-page="/Users/Index">Отмена</a>
    </div>

</form>