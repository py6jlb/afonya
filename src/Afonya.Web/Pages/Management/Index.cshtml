@page "{handler?}"
@model Afonya.Web.Pages.Management.IndexModel
@{
    ViewData["Title"] = "Управление";
}

<div itemid="=content">
    <div class="container-fluid">
        <div class="d-flex flex-row">
            <h4 class="p-2 mb-1 font-weight-bold text-primary">Управление</h4>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Функция</th>
                    <th scope="col">Состояние</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Telegram бот</th>
                    <td>@(Model.BotIsRunning ? "Получение сообщений работает" : "Получение сообщений остановлено")</td>
                    <td>
                        <form method="post">
                            @if (Model.BotIsRunning)
                            {
                                <button type="submit" class="btn btn-outline-primary btn-sm" asp-page-handler="botStop"> <i
                                        class="bi bi-toggle-on"></i></button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-primary btn-sm" asp-page-handler="botStart"> <i
                                        class="bi bi-toggle-off"></i></button>
                            }
                        </form>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
