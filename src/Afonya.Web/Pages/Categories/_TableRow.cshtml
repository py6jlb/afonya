@model CategoryDto

<tr>
  <td>@Model.Icon</td>
  <td>@Model.Name</td>
  <td>@Model.HumanName</td>
  <td>@(Model.IsActive ? "Да" : "Нет")</td>
  <td>
    <form method="post">
      <input type="text" hidden name="id" value="@Model.Id" />
      <input type="text" hidden name="icon" value="@Model.Icon" />
      <input type="text" hidden name="name" value="@Model.Name" />
      <input type="text" hidden name="humanName" value="@Model.HumanName" />
      <input type="text" hidden name="isActive" value="@(Model.IsActive ? "1" :"0")" />
      <button type="submit" class="btn btn-outline-primary btn-sm" asp-page-handler="Toggle">
        @if (Model.IsActive)
        {
          <i class="bi bi-toggle-on"></i>
        }
        else
        {
          <i class="bi bi-toggle-off"></i>
        }
      </button>

    </form>
  </td>
</tr>