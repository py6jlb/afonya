@using Afonya.Web.Pages.Statistics
@model IndexModel

<div class="row">
    <div class="col-12">
        <h4 class="p-2 mb-1 font-weight-bold">Статистика за @($"{Model.Month}".Length == 1 ?
                        $"0{Model.Month}" : $"{Model.Month}").@(Model.Year)
        </h4>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Расход(руб)</th>
            <th scope="col">Расход(%)</th>
            <th scope="col">Приход(руб)</th>
            <th scope="col">Приход(%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stat in Model.Statistics.ByCategories)
        {
            <tr>
                <th scope="row">@stat.CategoryIcon@stat.CategoryName</th>
                <td>@(stat.Minus == 0 ? "-" : stat.Minus)</td>
                <td>@(stat.MinusPercent == 0 ? "-" : stat.MinusPercent)</td>
                <td>@(stat.Plus == 0 ? "-" : stat.Plus)</td>
                <td>@(stat.PlusPercent == 0 ? "-" : stat.PlusPercent)</td>
            </tr>
        }
        <tr>
            <th scope="row">ИТОГО</th>
            <td>@(Model.Statistics.TotalMinus == 0 ? "-" : Model.Statistics.TotalMinus)</td>
            <td>--</td>
            <td>@(Model.Statistics.TotalPlus == 0 ? "-" : Model.Statistics.TotalPlus)</td>
            <td>--</td>
        </tr>
    </tbody>
</table>